# src/main/resources/graphql/schema.graphqls

# Types ===========================================
type User {
    id: ID!
    username: String!
    email: String!
    createdAt: String
}

type AuthPayload {
    accessToken: String!
    refreshToken: String!
    tokenType: String!
    expiresIn: Int!
    user: User!
}

type Post {
    id: ID!
    title: String!
    content: String!
    author: User!
    createdAt: String!
}

# Inputs ===========================================
input LoginInput {
    username: String!
    password: String!
}

input RegisterInput {
    username: String!
    email: String!
    password: String!
}

input CreatePostInput {
    title: String!
    content: String!
}

input RefreshTokenInput {
    refreshToken: String!
}

# Queries ===========================================
type Query {
    # ✅ Public - không cần token
    publicInfo: String!

    # 🔒 Protected - cần JWT hợp lệ  (@RequireLogin)
    me: User!
    myPosts: [Post!]!
    allPosts: [Post!]!
}

# Mutations ===========================================
type Mutation {
    # ✅ Public
    login(input: LoginInput!): AuthPayload!
    register(input: RegisterInput!): AuthPayload!
    refreshToken(input: RefreshTokenInput!): AuthPayload!

    # 🔒 Protected (@RequireLogin)
    createPost(input: CreatePostInput!): Post!
    logout: Boolean!
}
